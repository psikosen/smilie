{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desktop permissions for Smilie. Shell is desktop-only because the python sidecar is desktop-only.",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:path:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-exists",
    "shell:default"
  ]
}
