{
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.cargo.features": [],
  "editor.formatOnSave": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "files.exclude": {
    "**/target": true,
    "build": true,
    ".svelte-kit": true,
    "node_modules": true
  }
}
